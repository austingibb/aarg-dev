# Optional configuration; copy to scraper/.env. No Steam credentials required.
STEAMDB_PORT=4175
STEAMDB_CDP_URL=http://127.0.0.1:9222
STEAMDB_CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
STEAMDB_LAUNCH_CHROME=1
STEAMDB_HEADLESS=1
STEAMDB_GAP_SECONDS=300
STEAMDB_REFRESH_SECONDS=3600
STEAMDB_RETENTION_DAYS=30
